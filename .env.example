# Local development. Copy to .env and fill in.
DATABASE_URL=postgres://pa:pa@localhost:5433/pa
ANTHROPIC_API_KEY=
# Local dev server only: requests are treated as this Cognito sub when no token is sent.
DEV_AUTH_SUB=local-dev-user
# Optional: JSON merged over the built-in model config (planning/model-providers.md §5).
# Each keyed provider reads <PROVIDER>_API_KEY, e.g. OPENAI_API_KEY. Example, titles on a local Ollama model:
# MODEL_CONFIG={"providers":{"ollama":{"kind":"openai_compatible","base_url":"http://localhost:11434/v1","auth":"none"}},"models":{"ollama/llama3.1:8b":{"tools":true,"streaming":true,"jsonSchema":false,"contextWindow":128000}},"routes":{"chat.title":{"primary":"ollama/llama3.1:8b","fallback":"anthropic/claude-haiku-4-5"}}}
MODEL_CONFIG=
