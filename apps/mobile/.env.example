# Chat Lambda Function URL (stack output ChatBaseUrl), or the local dev server.
# From a device, use your machine's LAN address instead of localhost.
EXPO_PUBLIC_CHAT_BASE_URL=http://localhost:8787
# Cognito (stack outputs CognitoDomain and UserPoolClientId).
EXPO_PUBLIC_COGNITO_DOMAIN=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
# Local only: skip sign-in and let the dev server act as DEV_AUTH_SUB.
EXPO_PUBLIC_DEV_SKIP_AUTH=true
